{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "WebWorker"],
    "strict": true,
    "noEmitOnError": true,
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "outDir": "."
  },
  "include": ["*.ts", "*.d.ts"],
  "exclude": ["*.js"]
}